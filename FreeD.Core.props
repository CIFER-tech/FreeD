<Project>

  <!-- DLL を作らずに、普通の .NET アプリから FreeD の Core を使うための取り込み。
       使うプロジェクトの .csproj に <Import Project="パス\FreeD.Core.props" /> を書く。
       FreeDReceiver が RingBuffer を使うので、RingBuffer のプロジェクトへの参照も足す。 -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Unity\Runtime\Core\**\*.cs" Link="FreeD\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
