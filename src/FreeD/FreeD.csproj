<Project Sdk="Microsoft.NET.Sdk">

  <!-- ソースは Unity パッケージ (Unity/Runtime/Core) に置き、Unity と .NET のアプリで同じソースを使う。DLL は作って同梱しない -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>CIFER.tech.FreeD.Core</RootNamespace>
    <AssemblyName>CIFER.tech.FreeD.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Unity\Runtime\Core\**\*.cs" />
  </ItemGroup>

  <!-- FreeDReceiver が使う。RingBuffer のリポジトリを、このリポジトリの隣に置く -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\RingBuffer\src\RingBuffer\RingBuffer.csproj" />
  </ItemGroup>

</Project>
